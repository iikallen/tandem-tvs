# Copy to an operator-managed secret store or protected environment file.
# Never commit real values.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=tandem.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tandem.example.com
DATABASE_URL=postgresql://tandem:replace-with-a-strong-password@postgres:5432/tandem
POSTGRES_DB=tandem
POSTGRES_USER=tandem
POSTGRES_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://redis:6379/0
REALTIME_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2
REALTIME_ALLOWED_ORIGINS=https://tandem.example.com
AUTH_RECOVERY_MODE=ADMIN_ONLY
AUTH_PUBLIC_BASE_URL=https://tandem.example.com
WEB_PUSH_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
APP_VERSION=1.0.0
APP_GIT_SHA=replace-with-the-exact-40-character-lowercase-commit-sha
OPS_MONITORING_TOKEN=replace-with-at-least-32-random-characters
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tandem-tvs-tunnel-token
